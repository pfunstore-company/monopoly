{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monopoly",
  "compatibility_date": "2026-09-25",
  // 帳號 (Sky 2026-10-22): /api/* runs the worker (accounts and cloud saves); everything else is the static game.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNTS", "class_name": "Accounts" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Accounts"] }],
  // 公司網址 (Sky 2026-10-23): the game on the company's domain; the old workers.dev address keeps working for
  // the app builds already out there.
  "workers_dev": true,
  "routes": [{ "pattern": "boolionaire.pfunstore.company", "custom_domain": true }]
}
