{
	"appId": "com.skyyung.boolionaire",
	"appName": "Boolionaire",
	"webDir": "www",
	"server": {
		"url": "https://monopoly.zbs-yung.workers.dev/",
		"cleartext": false
	},
	"ios": {
		"contentInset": "never",
		"backgroundColor": "#1E1446"
	},
	"packageClassList": [
		"AdMobPlugin",
		"FirebaseAnalyticsPlugin",
		"FirebaseCrashlyticsPlugin",
		"FirebaseAuthenticationPlugin"
	],
	"plugins": {
		"FirebaseAuthentication": {
			"skipNativeAuth": false,
			"providers": [
				"google.com",
				"apple.com"
			]
		}
	}
}
